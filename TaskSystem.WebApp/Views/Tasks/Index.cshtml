@model TaskListViewModel
@{
    ViewData["Title"] = "Tasks";
}

<div class="row mb-4">
    <div class="col">
        <h2><i class="bi bi-list-check"></i> My Tasks</h2>
        <p class="lead">Manage your tasks efficiently.</p>
    </div>
    <div class="col-auto">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Create New Task
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body">
        @if (Model.Tasks.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Status</th>
                            <th>Priority</th>
                            <th>Assigned To</th>
                            <th>Due Date</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var task in Model.Tasks)
                        {
                            <tr>
                                <td>
                                    <a asp-action="Details" asp-route-id="@task.Id" class="text-decoration-none">
                                        @task.Title
                                    </a>
                                    @if (!string.IsNullOrEmpty(task.Description))
                                    {
                                        <br><small class="text-muted">@task.Description</small>
                                    }
                                </td>
                                <td>
                                    @switch (task.Status)
                                    {
                                        case TaskSystem.Core.Entities.TaskItemStatus.Pending:
                                            <span class="badge bg-warning">Pending</span>
                                            break;
                                        case TaskSystem.Core.Entities.TaskItemStatus.InProgress:
                                            <span class="badge bg-info">In Progress</span>
                                            break;
                                        case TaskSystem.Core.Entities.TaskItemStatus.Completed:
                                            <span class="badge bg-success">Completed</span>
                                            break;
                                        case TaskSystem.Core.Entities.TaskItemStatus.Cancelled:
                                            <span class="badge bg-danger">Cancelled</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @switch (task.Priority)
                                    {
                                        case TaskSystem.Core.Entities.TaskPriority.Low:
                                            <span class="badge bg-light text-dark">Low</span>
                                            break;
                                        case TaskSystem.Core.Entities.TaskPriority.Medium:
                                            <span class="badge bg-secondary">Medium</span>
                                            break;
                                        case TaskSystem.Core.Entities.TaskPriority.High:
                                            <span class="badge bg-warning">High</span>
                                            break;
                                        case TaskSystem.Core.Entities.TaskPriority.Critical:
                                            <span class="badge bg-danger">Critical</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(task.AssignedToName))
                                    {
                                        @task.AssignedToName
                                    }
                                    else
                                    {
                                        <span class="text-muted">Unassigned</span>
                                    }
                                </td>
                                <td>
                                    @if (task.DueDate.HasValue)
                                    {
                                        var daysUntilDue = (task.DueDate.Value.Date - DateTime.Now.Date).Days;
                                        <span class="@(daysUntilDue < 0 ? "text-danger" : daysUntilDue <= 3 ? "text-warning" : "")">
                                            @task.DueDate.Value.ToString("MMM dd, yyyy")
                                        </span>
                                        @if (daysUntilDue < 0)
                                        {
                                            <br><small class="text-danger">Overdue</small>
                                        }
                                        else if (daysUntilDue <= 3)
                                        {
                                            <br><small class="text-warning">Due soon</small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">No due date</span>
                                    }
                                </td>
                                <td>
                                    @task.CreatedAt.ToString("MMM dd, yyyy")
                                    <br><small class="text-muted">by @task.CreatedByName</small>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@task.Id" class="btn btn-outline-info" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @{
                                            var currentUserId = User.FindFirst("userId")?.Value;
                                            var canModify = Model.CurrentUserRole == "Admin" || Model.CurrentUserRole == "Manager" || 
                                                           task.CreatedById.ToString() == currentUserId || task.AssignedToId?.ToString() == currentUserId;
                                        }
                                        @if (canModify)
                                        {
                                            <a asp-action="Edit" asp-route-id="@task.Id" class="btn btn-outline-primary" title="Edit Task">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@task.Id" class="btn btn-outline-danger" title="Delete Task">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-list-check display-1 text-muted"></i>
                <h4 class="mt-3">No Tasks Found</h4>
                <p class="text-muted">You don't have any tasks yet. Create your first task to get started!</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Create Your First Task
                </a>
            </div>
        }
    </div>
</div>