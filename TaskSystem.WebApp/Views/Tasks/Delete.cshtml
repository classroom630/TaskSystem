@model TaskSystem.WebApp.Models.TaskItemViewModel

@{
    ViewData["Title"] = "Delete Task";
}

<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary me-3">
        <i class="fas fa-arrow-left"></i> Back to Tasks
    </a>
    <h2>@ViewData["Title"]</h2>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle"></i>
            <strong>Warning!</strong> This action cannot be undone. Are you sure you want to delete this task?
        </div>
        
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">@Model.Title</h5>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <p class="text-muted">@Model.Description</p>
                }
                
                <div class="mb-2">
                    <strong>Priority:</strong> <span class="badge @GetPriorityBadgeClass(Model.Priority)">@Model.Priority</span>
                </div>
                <div class="mb-2">
                    <strong>Status:</strong> <span class="badge @GetStatusBadgeClass(Model.Status)">@Model.Status.ToString()</span>
                </div>
                <div class="mb-2">
                    <strong>Created:</strong> @Model.CreatedAt.ToString("MMMM dd, yyyy")
                </div>
                @if (Model.DueDate.HasValue)
                {
                    <div class="mb-2">
                        <strong>Due Date:</strong> @Model.DueDate.Value.ToString("MMMM dd, yyyy")
                    </div>
                }
            </div>
            <div class="card-footer">
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash"></i> Yes, Delete Task
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetStatusBadgeClass(TaskSystem.WebApp.Models.TaskItemStatus status)
    {
        return status switch
        {
            TaskSystem.WebApp.Models.TaskItemStatus.Pending => "bg-warning text-dark",
            TaskSystem.WebApp.Models.TaskItemStatus.InProgress => "bg-info",
            TaskSystem.WebApp.Models.TaskItemStatus.Completed => "bg-success",
            TaskSystem.WebApp.Models.TaskItemStatus.Cancelled => "bg-danger",
            _ => "bg-secondary"
        };
    }

    string GetPriorityBadgeClass(TaskSystem.WebApp.Models.TaskPriority priority)
    {
        return priority switch
        {
            TaskSystem.WebApp.Models.TaskPriority.Low => "bg-secondary",
            TaskSystem.WebApp.Models.TaskPriority.Medium => "bg-primary",
            TaskSystem.WebApp.Models.TaskPriority.High => "bg-warning text-dark",
            TaskSystem.WebApp.Models.TaskPriority.Critical => "bg-danger",
            _ => "bg-secondary"
        };
    }
}