@model TaskDetailsViewModel
@{
    ViewData["Title"] = "Delete Task";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h4><i class="bi bi-exclamation-triangle"></i> Delete Task</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle"></i>
                    <strong>Warning:</strong> This action cannot be undone. Are you sure you want to delete this task?
                </div>

                <div class="row">
                    <div class="col-md-8">
                        <h5 class="mb-3">@Model.Task.Title</h5>
                        
                        @if (!string.IsNullOrEmpty(Model.Task.Description))
                        {
                            <div class="mb-3">
                                <h6 class="text-muted mb-2">Description</h6>
                                <p class="text-muted">@Model.Task.Description</p>
                            </div>
                        }

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <h6 class="text-muted mb-2">Status</h6>
                                @switch (Model.Task.Status)
                                {
                                    case TaskSystem.Core.Entities.TaskItemStatus.Pending:
                                        <span class="badge bg-warning">Pending</span>
                                        break;
                                    case TaskSystem.Core.Entities.TaskItemStatus.InProgress:
                                        <span class="badge bg-info">In Progress</span>
                                        break;
                                    case TaskSystem.Core.Entities.TaskItemStatus.Completed:
                                        <span class="badge bg-success">Completed</span>
                                        break;
                                    case TaskSystem.Core.Entities.TaskItemStatus.Cancelled:
                                        <span class="badge bg-danger">Cancelled</span>
                                        break;
                                }
                            </div>

                            <div class="col-md-6">
                                <h6 class="text-muted mb-2">Priority</h6>
                                @switch (Model.Task.Priority)
                                {
                                    case TaskSystem.Core.Entities.TaskPriority.Low:
                                        <span class="badge bg-light text-dark">Low</span>
                                        break;
                                    case TaskSystem.Core.Entities.TaskPriority.Medium:
                                        <span class="badge bg-secondary">Medium</span>
                                        break;
                                    case TaskSystem.Core.Entities.TaskPriority.High:
                                        <span class="badge bg-warning">High</span>
                                        break;
                                    case TaskSystem.Core.Entities.TaskPriority.Critical:
                                        <span class="badge bg-danger">Critical</span>
                                        break;
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card bg-light">
                            <div class="card-body">
                                <h6 class="card-title">Task Information</h6>
                                
                                <div class="mb-2">
                                    <small class="text-muted d-block">Created By</small>
                                    <span>@Model.Task.CreatedByName</span>
                                </div>

                                <div class="mb-2">
                                    <small class="text-muted d-block">Created Date</small>
                                    <span>@Model.Task.CreatedAt.ToString("MMM dd, yyyy")</span>
                                </div>

                                <div class="mb-2">
                                    <small class="text-muted d-block">Assigned To</small>
                                    @if (!string.IsNullOrEmpty(Model.Task.AssignedToName))
                                    {
                                        <span>@Model.Task.AssignedToName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Unassigned</span>
                                    }
                                </div>

                                @if (Model.Task.DueDate.HasValue)
                                {
                                    <div class="mb-2">
                                        <small class="text-muted d-block">Due Date</small>
                                        <span>@Model.Task.DueDate.Value.ToString("MMM dd, yyyy")</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <form asp-action="Delete" method="post" class="mt-4">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Yes, Delete Task
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.Task.Id" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>