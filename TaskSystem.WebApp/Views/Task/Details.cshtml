@model TaskDetailsViewModel
@{
    ViewData["Title"] = "Task Details";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4><i class="bi bi-info-circle"></i> Task Details</h4>
                <div class="btn-group" role="group">
                    @if (Model.CanEdit)
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Task.Id" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                    }
                    @if (Model.CanDelete)
                    {
                        <a asp-action="Delete" asp-route-id="@Model.Task.Id" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                    }
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>
                </div>
            </div>
            <div class="card-body">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show">
                        <i class="bi bi-check-circle"></i> @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <div class="row">
                    <div class="col-md-8">
                        <h2 class="mb-3">@Model.Task.Title</h2>
                        
                        @if (!string.IsNullOrEmpty(Model.Task.Description))
                        {
                            <div class="mb-4">
                                <h6 class="text-muted mb-2">Description</h6>
                                <p class="fs-6">@Model.Task.Description</p>
                            </div>
                        }

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <h6 class="text-muted mb-2">Status</h6>
                                @switch (Model.Task.Status)
                                {
                                    case TaskSystem.Core.Entities.TaskItemStatus.Pending:
                                        <span class="badge bg-warning fs-6">Pending</span>
                                        break;
                                    case TaskSystem.Core.Entities.TaskItemStatus.InProgress:
                                        <span class="badge bg-info fs-6">In Progress</span>
                                        break;
                                    case TaskSystem.Core.Entities.TaskItemStatus.Completed:
                                        <span class="badge bg-success fs-6">Completed</span>
                                        break;
                                    case TaskSystem.Core.Entities.TaskItemStatus.Cancelled:
                                        <span class="badge bg-danger fs-6">Cancelled</span>
                                        break;
                                }
                            </div>

                            <div class="col-md-6">
                                <h6 class="text-muted mb-2">Priority</h6>
                                @switch (Model.Task.Priority)
                                {
                                    case TaskSystem.Core.Entities.TaskPriority.Low:
                                        <span class="badge bg-light text-dark fs-6">Low</span>
                                        break;
                                    case TaskSystem.Core.Entities.TaskPriority.Medium:
                                        <span class="badge bg-secondary fs-6">Medium</span>
                                        break;
                                    case TaskSystem.Core.Entities.TaskPriority.High:
                                        <span class="badge bg-warning fs-6">High</span>
                                        break;
                                    case TaskSystem.Core.Entities.TaskPriority.Critical:
                                        <span class="badge bg-danger fs-6">Critical</span>
                                        break;
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card bg-light">
                            <div class="card-body">
                                <h6 class="card-title">Task Information</h6>
                                
                                <div class="mb-3">
                                    <small class="text-muted d-block">Created By</small>
                                    <span>@Model.Task.CreatedByName</span>
                                </div>

                                <div class="mb-3">
                                    <small class="text-muted d-block">Created Date</small>
                                    <span>@Model.Task.CreatedAt.ToString("MMM dd, yyyy 'at' HH:mm")</span>
                                </div>

                                @if (Model.Task.UpdatedAt.HasValue)
                                {
                                    <div class="mb-3">
                                        <small class="text-muted d-block">Last Updated</small>
                                        <span>@Model.Task.UpdatedAt.Value.ToString("MMM dd, yyyy 'at' HH:mm")</span>
                                    </div>
                                }

                                <div class="mb-3">
                                    <small class="text-muted d-block">Assigned To</small>
                                    @if (!string.IsNullOrEmpty(Model.Task.AssignedToName))
                                    {
                                        <span>@Model.Task.AssignedToName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Unassigned</span>
                                    }
                                </div>

                                @if (Model.Task.DueDate.HasValue)
                                {
                                    <div class="mb-3">
                                        <small class="text-muted d-block">Due Date</small>
                                        @{
                                            var daysUntilDue = (Model.Task.DueDate.Value.Date - DateTime.Now.Date).Days;
                                        }
                                        <span class="@(daysUntilDue < 0 ? "text-danger fw-bold" : daysUntilDue <= 3 ? "text-warning fw-bold" : "")">
                                            @Model.Task.DueDate.Value.ToString("MMM dd, yyyy")
                                        </span>
                                        @if (daysUntilDue < 0)
                                        {
                                            <br><small class="text-danger fw-bold">Overdue by @(-daysUntilDue) day(s)</small>
                                        }
                                        else if (daysUntilDue == 0)
                                        {
                                            <br><small class="text-warning fw-bold">Due today!</small>
                                        }
                                        else if (daysUntilDue <= 3)
                                        {
                                            <br><small class="text-warning fw-bold">Due in @daysUntilDue day(s)</small>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="mb-3">
                                        <small class="text-muted d-block">Due Date</small>
                                        <span class="text-muted fst-italic">No due date set</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>