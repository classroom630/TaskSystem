@{
    ViewData["Title"] = "Dashboard";
}

<div class="row mb-4">
    <div class="col">
        <h2><i class="bi bi-speedometer2"></i> Dashboard</h2>
        <p class="lead">Welcome back, @ViewBag.UserName! Here's your overview.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(ViewBag.Error))
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle"></i> @ViewBag.Error
    </div>
}

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="card text-white bg-primary">
            <div class="card-body">
                <div class="row">
                    <div class="col-8">
                        <h4>@ViewBag.TaskCount</h4>
                        <p class="card-text">Total Tasks</p>
                    </div>
                    <div class="col-4 text-end">
                        <i class="bi bi-list-check" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3 mb-3">
        <div class="card text-white bg-warning">
            <div class="card-body">
                <div class="row">
                    <div class="col-8">
                        <h4>@ViewBag.PendingTasks</h4>
                        <p class="card-text">Pending</p>
                    </div>
                    <div class="col-4 text-end">
                        <i class="bi bi-clock" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3 mb-3">
        <div class="card text-white bg-info">
            <div class="card-body">
                <div class="row">
                    <div class="col-8">
                        <h4>@ViewBag.InProgressTasks</h4>
                        <p class="card-text">In Progress</p>
                    </div>
                    <div class="col-4 text-end">
                        <i class="bi bi-arrow-repeat" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3 mb-3">
        <div class="card text-white bg-success">
            <div class="card-body">
                <div class="row">
                    <div class="col-8">
                        <h4>@ViewBag.CompletedTasks</h4>
                        <p class="card-text">Completed</p>
                    </div>
                    <div class="col-4 text-end">
                        <i class="bi bi-check-circle" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Recent Tasks -->
    <div class="col-md-8 mb-4">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5><i class="bi bi-list-task"></i> Recent Tasks</h5>
                <a href="/Tasks" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body">
                @if (ViewBag.RecentTasks != null && ((IEnumerable<object>)ViewBag.RecentTasks).Any())
                {
                    <ul class="nav nav-tabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="recent-table-tab" data-bs-toggle="tab" data-bs-target="#recent-table" type="button" role="tab" aria-controls="recent-table" aria-selected="true">
                                <i class="bi bi-table"></i> Table
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="recent-board-tab" data-bs-toggle="tab" data-bs-target="#recent-board" type="button" role="tab" aria-controls="recent-board" aria-selected="false">
                                <i class="bi bi-kanban"></i> Board
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content pt-3">
                        <!-- Table view -->
                        <div class="tab-pane fade show active" id="recent-table" role="tabpanel" aria-labelledby="recent-table-tab">
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Title</th>
                                            <th>Status</th>
                                            <th>Priority</th>
                                            <th>Due Date</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var task in (IEnumerable<dynamic>)ViewBag.RecentTasks)
                                        {
                                            <tr>
                                                <td>@task.Title</td>
                                                <td>
                                                    @switch (task.Status)
                                                    {
                                                        case TaskSystem.Core.Entities.TaskItemStatus.Pending:
                                                            <span class="badge bg-warning">Pending</span>
                                                            break;
                                                        case TaskSystem.Core.Entities.TaskItemStatus.InProgress:
                                                            <span class="badge bg-info">In Progress</span>
                                                            break;
                                                        case TaskSystem.Core.Entities.TaskItemStatus.Completed:
                                                            <span class="badge bg-success">Completed</span>
                                                            break;
                                                        case TaskSystem.Core.Entities.TaskItemStatus.Cancelled:
                                                            <span class="badge bg-danger">Cancelled</span>
                                                            break;
                                                    }
                                                </td>
                                                <td>
                                                    @switch (task.Priority)
                                                    {
                                                        case TaskSystem.Core.Entities.TaskPriority.Low:
                                                            <span class="badge bg-light text-dark">Low</span>
                                                            break;
                                                        case TaskSystem.Core.Entities.TaskPriority.Medium:
                                                            <span class="badge bg-secondary">Medium</span>
                                                            break;
                                                        case TaskSystem.Core.Entities.TaskPriority.High:
                                                            <span class="badge bg-warning">High</span>
                                                            break;
                                                        case TaskSystem.Core.Entities.TaskPriority.Critical:
                                                            <span class="badge bg-danger">Critical</span>
                                                            break;
                                                    }
                                                </td>
                                                <td>
                                                    @if (task.DueDate != null)
                                                    {
                                                        @(((DateTime?)task.DueDate)?.ToString("MMM dd, yyyy"))
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">No due date</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Board view -->
                        <div class="tab-pane fade" id="recent-board" role="tabpanel" aria-labelledby="recent-board-tab">
                            @{ 
                                var recent = ((IEnumerable<dynamic>)ViewBag.RecentTasks).ToList();
                                var pending = recent.Where(t => t.Status == TaskSystem.Core.Entities.TaskItemStatus.Pending).ToList();
                                var inProgress = recent.Where(t => t.Status == TaskSystem.Core.Entities.TaskItemStatus.InProgress).ToList();
                                var completed = recent.Where(t => t.Status == TaskSystem.Core.Entities.TaskItemStatus.Completed).ToList();
                                var cancelled = recent.Where(t => t.Status == TaskSystem.Core.Entities.TaskItemStatus.Cancelled).ToList();
                            }
                            <div class="row g-3">
                                <div class="col-12 col-md-6 col-lg-3">
                                    <div class="card h-100">
                                        <div class="card-header d-flex justify-content-between align-items-center">
                                            <strong>Pending</strong>
                                            <span class="badge bg-secondary">@pending.Count</span>
                                        </div>
                                        <div class="card-body">
                                            <div class="kanban-column" data-status="@((int)TaskSystem.Core.Entities.TaskItemStatus.Pending)">
                                                @foreach (var t in pending)
                                                {
                                                    <div class="kanban-item" draggable="true" data-id="@t.Id">
                                                        <div class="d-flex justify-content-between">
                                                            <span class="fw-semibold">@t.Title</span>
                                                            @switch (t.Priority)
                                                            {
                                                                case TaskSystem.Core.Entities.TaskPriority.Low:
                                                                    <span class="badge bg-light text-dark">Low</span>
                                                                    break;
                                                                case TaskSystem.Core.Entities.TaskPriority.Medium:
                                                                    <span class="badge bg-secondary">Medium</span>
                                                                    break;
                                                                case TaskSystem.Core.Entities.TaskPriority.High:
                                                                    <span class="badge bg-warning">High</span>
                                                                    break;
                                                                case TaskSystem.Core.Entities.TaskPriority.Critical:
                                                                    <span class="badge bg-danger">Critical</span>
                                                                    break;
                                                            }
                                                        </div>
                                                        @if (t.DueDate != null)
                                                        {
                                                            <small class="text-muted">Due @(((DateTime?)t.DueDate)?.ToString("MMM dd"))</small>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12 col-md-6 col-lg-3">
                                    <div class="card h-100">
                                        <div class="card-header d-flex justify-content-between align-items-center">
                                            <strong>In Progress</strong>
                                            <span class="badge bg-secondary">@inProgress.Count</span>
                                        </div>
                                        <div class="card-body">
                                            <div class="kanban-column" data-status="@((int)TaskSystem.Core.Entities.TaskItemStatus.InProgress)">
                                                @foreach (var t in inProgress)
                                                {
                                                    <div class="kanban-item" draggable="true" data-id="@t.Id">
                                                        <div class="d-flex justify-content-between">
                                                            <span class="fw-semibold">@t.Title</span>
                                                            @switch (t.Priority)
                                                            {
                                                                case TaskSystem.Core.Entities.TaskPriority.Low:
                                                                    <span class="badge bg-light text-dark">Low</span>
                                                                    break;
                                                                case TaskSystem.Core.Entities.TaskPriority.Medium:
                                                                    <span class="badge bg-secondary">Medium</span>
                                                                    break;
                                                                case TaskSystem.Core.Entities.TaskPriority.High:
                                                                    <span class="badge bg-warning">High</span>
                                                                    break;
                                                                case TaskSystem.Core.Entities.TaskPriority.Critical:
                                                                    <span class="badge bg-danger">Critical</span>
                                                                    break;
                                                            }
                                                        </div>
                                                        @if (t.DueDate != null)
                                                        {
                                                            <small class="text-muted">Due @(((DateTime?)t.DueDate)?.ToString("MMM dd"))</small>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12 col-md-6 col-lg-3">
                                    <div class="card h-100">
                                        <div class="card-header d-flex justify-content-between align-items-center">
                                            <strong>Completed</strong>
                                            <span class="badge bg-secondary">@completed.Count</span>
                                        </div>
                                        <div class="card-body">
                                            <div class="kanban-column" data-status="@((int)TaskSystem.Core.Entities.TaskItemStatus.Completed)">
                                                @foreach (var t in completed)
                                                {
                                                    <div class="kanban-item" draggable="true" data-id="@t.Id">
                                                        <div class="d-flex justify-content-between">
                                                            <span class="fw-semibold">@t.Title</span>
                                                            @switch (t.Priority)
                                                            {
                                                                case TaskSystem.Core.Entities.TaskPriority.Low:
                                                                    <span class="badge bg-light text-dark">Low</span>
                                                                    break;
                                                                case TaskSystem.Core.Entities.TaskPriority.Medium:
                                                                    <span class="badge bg-secondary">Medium</span>
                                                                    break;
                                                                case TaskSystem.Core.Entities.TaskPriority.High:
                                                                    <span class="badge bg-warning">High</span>
                                                                    break;
                                                                case TaskSystem.Core.Entities.TaskPriority.Critical:
                                                                    <span class="badge bg-danger">Critical</span>
                                                                    break;
                                                            }
                                                        </div>
                                                        @if (t.DueDate != null)
                                                        {
                                                            <small class="text-muted">Due @(((DateTime?)t.DueDate)?.ToString("MMM dd"))</small>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12 col-md-6 col-lg-3">
                                    <div class="card h-100">
                                        <div class="card-header d-flex justify-content-between align-items-center">
                                            <strong>Cancelled</strong>
                                            <span class="badge bg-secondary">@cancelled.Count</span>
                                        </div>
                                        <div class="card-body">
                                            <div class="kanban-column" data-status="@((int)TaskSystem.Core.Entities.TaskItemStatus.Cancelled)">
                                                @foreach (var t in cancelled)
                                                {
                                                    <div class="kanban-item" draggable="true" data-id="@t.Id">
                                                        <div class="d-flex justify-content-between">
                                                            <span class="fw-semibold">@t.Title</span>
                                                            @switch (t.Priority)
                                                            {
                                                                case TaskSystem.Core.Entities.TaskPriority.Low:
                                                                    <span class="badge bg-light text-dark">Low</span>
                                                                    break;
                                                                case TaskSystem.Core.Entities.TaskPriority.Medium:
                                                                    <span class="badge bg-secondary">Medium</span>
                                                                    break;
                                                                case TaskSystem.Core.Entities.TaskPriority.High:
                                                                    <span class="badge bg-warning">High</span>
                                                                    break;
                                                                case TaskSystem.Core.Entities.TaskPriority.Critical:
                                                                    <span class="badge bg-danger">Critical</span>
                                                                    break;
                                                            }
                                                        </div>
                                                        @if (t.DueDate != null)
                                                        {
                                                            <small class="text-muted">Due @(((DateTime?)t.DueDate)?.ToString("MMM dd"))</small>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center">No tasks found.</p>
                }
            </div>
        </div>
    </div>

    <!-- Admin Panel (if user is admin) -->
    @if (ViewBag.UserRole == "Admin")
    {
        <div class="col-md-4 mb-4">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5><i class="bi bi-people"></i> User Management</h5>
                    <a href="/Users" class="btn btn-sm btn-outline-primary">Manage</a>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <h6><i class="bi bi-person-check"></i> Total Users: @ViewBag.UserCount</h6>
                    </div>
                    
                    @if (ViewBag.RecentUsers != null && ((IEnumerable<object>)ViewBag.RecentUsers).Any())
                    {
                        <h6 class="mb-2">Recent Users:</h6>
                        <div class="list-group list-group-flush">
                            @foreach (var user in (IEnumerable<dynamic>)ViewBag.RecentUsers)
                            {
                                <div class="list-group-item list-group-item-action">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">@user.FullName</h6>
                                        <small class="text-muted">@user.Role</small>
                                    </div>
                                    <p class="mb-1">@user.Email</p>
                                </div>
                            }
                        </div>
                    }
                    
                    <div class="mt-3">
                        <a href="/Users/Create" class="btn btn-outline-primary btn-sm w-100">
                            <i class="bi bi-person-plus"></i> Add New User
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Quick Actions for non-admin users -->
        <div class="col-md-4 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5><i class="bi bi-lightning"></i> Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="/Tasks/Create" class="btn btn-primary">
                            <i class="bi bi-plus-circle"></i> Create New Task
                        </a>
                        <a href="/Tasks" class="btn btn-outline-secondary">
                            <i class="bi bi-list-check"></i> View My Tasks
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <style>
        .kanban-column { min-height: 200px; padding: .5rem; background-color: #f8f9fa; border-radius: .25rem; }
        .kanban-item { background: #fff; border: 1px solid #e9ecef; border-radius: .25rem; padding: .5rem .75rem; margin-bottom: .5rem; cursor: grab; }
        .kanban-column.drag-over { outline: 2px dashed #0d6efd; background-color: #eef5ff; }
    </style>
    <script>
        (function () {
            const board = document.getElementById('recent-board');
            if (!board) return;

            const columns = board.querySelectorAll('.kanban-column');
            let dragged = null;

            function updateCounts() {
                board.querySelectorAll('.kanban-column').forEach(kc => {
                    const count = kc.querySelectorAll('.kanban-item').length;
                    const badge = kc.closest('.card').querySelector('.badge.bg-secondary');
                    if (badge) badge.textContent = count;
                });
            }

            board.querySelectorAll('.kanban-item').forEach(item => {
                item.addEventListener('dragstart', e => {
                    dragged = item;
                    e.dataTransfer.setData('text/plain', item.getAttribute('data-id'));
                    e.dataTransfer.effectAllowed = 'move';
                });
                item.addEventListener('dragend', () => {
                    dragged = null;
                    columns.forEach(c => c.classList.remove('drag-over'));
                });
            });

            columns.forEach(col => {
                col.addEventListener('dragover', e => {
                    e.preventDefault();
                    e.dataTransfer.dropEffect = 'move';
                    col.classList.add('drag-over');
                });
                col.addEventListener('dragleave', () => col.classList.remove('drag-over'));
                col.addEventListener('drop', async e => {
                    e.preventDefault();
                    col.classList.remove('drag-over');
                    const id = e.dataTransfer.getData('text/plain');
                    if (!id) return;
                    const targetStatus = parseInt(col.getAttribute('data-status'));

                    if (dragged && dragged.parentElement !== col) {
                        col.prepend(dragged);
                        updateCounts();
                    }

                    try {
                        const resp = await fetch('@Url.Action("UpdateStatus", "Tasks")', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ id: parseInt(id), status: targetStatus })
                        });
                        if (!resp.ok) {
                            window.location.reload();
                        }
                    } catch (err) {
                        console.error(err);
                        window.location.reload();
                    }
                });
            });
        })();
    </script>
}